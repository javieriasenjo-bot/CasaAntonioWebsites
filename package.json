{
  "name": "casa-antonio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/strip-redirects.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "node scripts/cf-postinstall.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && node --test tests/analytics.test.mjs tests/build.test.mjs tests/indexnow.test.mjs tests/campaign-links.test.mjs",
    "campaign-links": "node scripts/campaign-links.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.2.0",
    "wrangler": "4.144.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.0"
  }
}
